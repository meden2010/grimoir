{
  "name": "grimoir",
  "version": "0.1.0",
  "description": "Unified test report tool that consolidates E2E, performance, API and unit test results into a single visual report",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter/index.d.ts",
      "default": "./dist/reporter/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "grimoir": "./dist/cli/index.js"
  },
  "scripts": {
    "prepare": "bun run build",
    "build": "tsc",
    "postbuild": "copyfiles -u 1 src/**/*.html src/**/*.css src/**/*.js dist/",
    "dev": "bun src/cli/index.ts",
    "dev:watch": "bun --watch src/cli/index.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "report": "grimoir generate --input ./test-results --output ./output",
    "lint": "tsc --noEmit",
    "audit:compat": "bun scripts/audit-node-compat.ts",
    "test:compat": "bun run build && bun scripts/generate-demo-data.ts && node dist/cli/index.js generate --input tests/fixtures/demo-output --output ./output --no-serve && node dist/cli/index.js clean --output ./output",
    "dev:demo": "bun scripts/generate-demo-data.ts && bun src/cli/index.ts generate --input tests/fixtures/demo-output --output ./output",
    "gate": "bun test && bun run lint && bun run audit:compat && bun run test:compat && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meden2010/grimoir.git"
  },
  "keywords": [
    "testing",
    "qa",
    "test-report",
    "playwright",
    "k6",
    "unified-report"
  ],
  "author": "Saúl Sosa",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/meden2010/grimoir/issues"
  },
  "homepage": "https://github.com/meden2010/grimoir#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "jsdom": "^30.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "@types/node": "^25.9.3",
    "copyfiles": "^2.4.1",
    "typescript": "^6.0.3"
  }
}
